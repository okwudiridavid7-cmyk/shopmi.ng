# Copy to .env at the repo root (and symlink/copy into apps as needed).
# Secrets stay here — NEVER put these in platform_settings.

# Database — PostgreSQL (Neon, Render, or local Docker)
# Neon: use the *pooled* URL for DATABASE_URL and the *direct* (non-pooler) URL for DIRECT_URL.
# Local Docker (docker compose): both can be the same.
DATABASE_URL="postgresql://vendors:vendors@localhost:5433/vendors"
DIRECT_URL="postgresql://vendors:vendors@localhost:5433/vendors"

# Redis (Phase 3+; included in docker-compose for local parity)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars!"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth2 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Paystack (https://dashboard.paystack.com/#/settings/developer)
# Use test keys for local MVP. Platform collects full payment (no split yet).
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Resend (https://resend.com) — order confirmation emails
RESEND_API_KEY=""
EMAIL_FROM="Vendors <onboarding@resend.dev>"

# Anthropic Claude (Wave 2 AI product descriptions). Without this key, worker uses a template fallback.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# Shop subdomain base — use lvh.me for local multi-tenant hosts (see README)
SHOP_BASE_DOMAIN="lvh.me:3000"

# WhatsApp Cloud API (Phase 4). Without these, order alerts are logged and skipped.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Cloudflare Turnstile (contact forms). Required in production (fail closed).
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Non-prod test bypass only — ignored when NODE_ENV=production
CONTACT_CAPTCHA_BYPASS="false"
# Contact inquiry DB retention before purge job (days). Default 180.
CONTACT_INQUIRY_RETENTION_DAYS="180"
# Shop contact: require submitter email confirmation before notifying the shop (REM-17).
# Keep false in production until confirm UX is click-to-confirm (see hostile review).
SHOP_CONTACT_CONFIRM_REQUIRED="false"

# Public URLs (secrets stay here). Site name is edited in Admin → Settings (app_name).
# APP_NAME is only a seed fallback for first install.
APP_NAME="Shopmi.ng"
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
COOKIE_DOMAIN="localhost"
NODE_ENV="development"

# --- Production examples (Render + Cloudflare) ---
# API_URL="https://api.shopmi.ng"
# WEB_URL="https://shopmi.ng"
# SHOP_BASE_DOMAIN="shopmi.ng"
# COOKIE_DOMAIN=".shopmi.ng"
# ALLOWED_ORIGINS="https://shopmi.ng,https://www.shopmi.ng"
# NODE_ENV="production"

# Super admin seed (pnpm db:seed)
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="change-me-strong-password"
