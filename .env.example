# Copy to .env at the repo root (and symlink/copy into apps as needed).
# Secrets stay here — NEVER put these in platform_settings.

# Database — PostgreSQL (Neon, Render, or local Docker)
# Neon: use the *pooled* URL for DATABASE_URL and the *direct* (non-pooler) URL for DIRECT_URL.
# Local Docker (docker compose): both can be the same.
DATABASE_URL="postgresql://vendors:vendors@localhost:5433/vendors"
DIRECT_URL="postgresql://vendors:vendors@localhost:5433/vendors"

# Redis (Phase 3+; included in docker-compose for local parity)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars!"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth2 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Paystack (https://dashboard.paystack.com/#/settings/developer)
# Use test keys for local MVP. Platform collects full payment (no split yet).
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Resend (https://resend.com) — order confirmation emails
RESEND_API_KEY=""
EMAIL_FROM="Vendors <onboarding@resend.dev>"

# Anthropic Claude (AI product descriptions). Without this key, Generate description stays hidden.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# Photoroom background removal. Without this key, Enhance stays hidden.
PHOTOROOM_API_KEY=""

# Cloudflare R2 (S3 API). Required in production — Render disk is ephemeral.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BUCKET=""
R2_PRIVATE_BUCKET=""
MEDIA_URL="http://localhost:4000"
# Web (bake at build): NEXT_PUBLIC_MEDIA_URL should match MEDIA_URL in prod (https://media.shopmi.ng)

# Shop subdomain base — use lvh.me for local multi-tenant hosts (see README)
SHOP_BASE_DOMAIN="lvh.me:3000"

# WhatsApp Cloud API. Without token + phone id, sends are skipped (logged only).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_VERSION="v21.0"
WHATSAPP_TEMPLATE_NEW_ORDER="new_order"
# Authentication template: body {{1}} = OTP code (optional copy-code button)
WHATSAPP_TEMPLATE_PHONE_OTP="phone_otp"
# Utility: {{1}} status, {{2}} shop, {{3}} detail, {{4}} reference
WHATSAPP_TEMPLATE_ORDER_UPDATE="order_update"
# Utility: {{1}} title, {{2}} body, {{3}} action hint
WHATSAPP_TEMPLATE_REMINDER="reminder"
WHATSAPP_TEMPLATE_LANG="en"
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""

# Cloudflare Turnstile. Required in production for contact + auth (fail closed).
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Non-prod test bypass only — ignored when NODE_ENV=production
CONTACT_CAPTCHA_BYPASS="false"
# Contact inquiry DB retention before purge job (days). Default 180.
CONTACT_INQUIRY_RETENTION_DAYS="180"
# Shop contact: require submitter email confirmation before notifying the shop (REM-17).
# Keep false in production until confirm UX is click-to-confirm (see hostile review).
SHOP_CONTACT_CONFIRM_REQUIRED="false"

# Public URLs (secrets stay here). Site name is edited in Admin → Settings (app_name).
# APP_NAME is only a seed fallback for first install.
APP_NAME="Shopmi.ng"
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
COOKIE_DOMAIN="localhost"
NODE_ENV="development"
PORT="4000"
ALLOWED_ORIGINS=""
ADMIN_ALERT_EMAIL=""

# Optional error tracking (https://sentry.io free tier)
SENTRY_DSN=""

# --- Production examples (Render + Cloudflare) ---
# API_URL="https://api.shopmi.ng"
# WEB_URL="https://shopmi.ng"
# SHOP_BASE_DOMAIN="shopmi.ng"
# COOKIE_DOMAIN=".shopmi.ng"
# MEDIA_URL="https://media.shopmi.ng"
# ALLOWED_ORIGINS="https://shopmi.ng,https://www.shopmi.ng"
# NODE_ENV="production"

# Super admin seed (pnpm db:seed)
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="change-me"
# Set true only when you intentionally want seed to overwrite the admin password
SUPER_ADMIN_RESET_PASSWORD="false"
SUPER_ADMIN_NAME=""

# Seller custom domains: where connected domains point
CUSTOM_DOMAIN_CNAME_TARGET="shopmi-web.onrender.com"
CUSTOM_DOMAIN_A_RECORD="216.24.57.1"

# Render API: attaches seller domains to shopmi-web and issues SSL
RENDER_API_KEY=""
RENDER_WEB_SERVICE_ID=""

# GO54 (WhoGoHost) domain reseller API. Empty = local stand-in (dev) / buying off (prod)
GO54_API_EMAIL=""
GO54_API_KEY=""
GO54_API_URL="https://www.whogohost.com/host/modules/addons/DomainsReseller/api/index.php"
GO54_NAMESERVERS="nsa.whogohost.com,nsb.whogohost.com"
